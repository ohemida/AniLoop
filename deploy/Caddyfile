{
	admin off
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 300s
			idle 60s
		}
	}
}

{$ANILOOP_SITE} {
	# No access log: avoid storing visitor IPs, URLs or cookies by default.
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:8097 {
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
		}
	}
}
