# Environment variables, not loaded automatically. Set in your host or shell.
HOST=127.0.0.1
PORT=8097
ANILOOP_DB=.runtime/community.sqlite3
# Public HTTPS deployment only:
# ANILOOP_SECURE_COOKIES=1
# ANILOOP_PUBLIC_ORIGIN=https://your-domain.example

# Managed retention runs at server startup and hourly. No accounts or scores expire.
# Optional daily SQLite snapshots (kept 30 days) in .runtime/privacy-managed/community.sqlite3/backups:
ANILOOP_MANAGED_BACKUPS=0
# Off by default. Opt-in timestamp/status only, no IP/URL/user agent; kept 7 days:
ANILOOP_ACCESS_LOG=0

# Supabase Auth/profile integration uses supabase/project.json by default.
# Override with environment variables; no secret/service-role key is needed.
# ANILOOP_SUPABASE_ENABLED=0  # Local-only accounts
# ANILOOP_SUPABASE_URL=https://your-project.supabase.co
# ANILOOP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Game scores/friends/rewards/rooms remain on this Python server's SQLite DB.
# Supabase session credentials are encrypted in SQLite; keep its private .session-key file.
# Database and key must remain in the same private persistent runtime volume.
